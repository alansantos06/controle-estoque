
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Requisições | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'requisicoes' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                paginaAtiva: 'requisicoes',
                tituloPagina: 'Requisições'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">OPERAÇÕES</p>
                    <h2>Requisições de materiais</h2>
                    <p>Solicite materiais e acompanhe as decisões das requisições.</p>
                </div>

                <div class="compra-acoes-topo">
                    <% if (permissoes.criarRequisicao) { %>
                        <a href="/requisicoes/nova" class="primary-link">
                            ＋ Nova requisição
                        </a>
                    <% } %>
                    <a href="/requisicoes/editar" class="compra-botao-topo" data-selecao-href="/requisicoes/editar?id=">
                        ✎ Editar
                    </a>
                    <a href="/requisicoes/excluir" class="compra-botao-topo compra-botao-topo-perigo" data-selecao-href="/requisicoes/excluir?id=">
                        🗑 Excluir
                    </a>
                    <% if (permissoes.aprovarRequisicao) { %>
                        <%- include('partials/botoes-decisao', { base: '/requisicoes' }) %>
                    <% } %>
                </div>
            </section>

            <% if (mensagem) { %>
                <div class="mensagem-sucesso" id="mensagemSucesso" role="status">
                    <%= mensagem %>
                </div>
            <% } %>

            <% if (erro) { %>
                <div class="mensagem-erro" id="mensagemErro" role="alert">
                    <%= erro %>
                </div>
            <% } %>

            <section class="panel-card requisicoes-card">
                <div class="panel-header">
                    <div>
                        <h2>Requisições registradas</h2>
                        <p>Acompanhe o status e as decisões de cada solicitação.</p>
                    </div>
                    <span class="codigo-produto">
                        Total: <%= requisicoes.length %>
                    </span>
                </div>

                <% if (requisicoes.length === 0) { %>
                    <div class="empty-state">
                        <span>✓</span>
                        <p>Nenhuma requisição cadastrada ainda.</p>
                    </div>
                <% } else { %>

                    <p class="dica-selecao">
                        <span aria-hidden="true">👆</span>
                        Clique em uma requisição pendente para selecioná-la e depois use os botões do topo.
                    </p>

                    <div class="table-wrapper tabela-requisicoes">
                        <table class="dashboard-table tabela-selecionavel">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Produto</th>
                                    <th>Quantidade</th>
                                    <th>Solicitante</th>
                                    <th>Data</th>
                                    <th>Status</th>
                                    <th>Observação</th>
                                    <th>Decisão</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% requisicoes.forEach(requisicao => {
                                    const pendente = requisicao.status === 'Pendente';
                                    const estoqueAtual = requisicao.produtos ? requisicao.produtos.quantidade : 0;
                                %>
                                    <tr
                                        <% if (pendente) { %>
                                            class="linha-selecionavel"
                                            tabindex="0"
                                            aria-selected="false"
                                            data-id="<%= requisicao.id %>"
                                            data-codigo="<%= String(requisicao.id).padStart(5, '0') %>"
                                            data-resumo="<%= (requisicao.produtos ? requisicao.produtos.nome : 'Produto não encontrado') + ' — ' + requisicao.quantidade + ' un. · ' + requisicao.solicitante %>"
                                            data-alerta="<%= requisicao.quantidade > estoqueAtual ? 'Estoque insuficiente: há ' + estoqueAtual + ' em estoque.' : '' %>"
                                        <% } %>
                                    >
                                        <td><strong class="compra-codigo">#<%= String(requisicao.id).padStart(5, '0') %></strong></td>

                                        <td>
                                            <%= requisicao.produtos
                                                ? requisicao.produtos.nome
                                                : 'Produto não encontrado' %>
                                        </td>

                                        <td><strong><%= requisicao.quantidade %></strong></td>

                                        <td><%= requisicao.solicitante %></td>

                                        <td>
                                            <%= new Date(requisicao.data_solicitacao)
                                                .toLocaleString('pt-BR') %>
                                        </td>

                                        <td>
                                            <span class="status-requisicao status-<%= requisicao.status.toLowerCase() %>">
                                                <%= requisicao.status %>
                                            </span>
                                        </td>

                                        <td><%= requisicao.observacao || '-' %></td>

                                        <td>
                                            <% if (requisicao.status === 'Pendente') { %>
                                                <span class="compra-vazio">Aguardando decisão</span>
                                            <% } else { %>
                                                <div class="compra-pessoa">
                                                    <span><%= requisicao.status === 'Rejeitada' ? 'Rejeitada por' : 'Aprovada por' %></span>
                                                    <strong><%= requisicao.responsavel_decisao || '—' %></strong>
                                                    <% if (requisicao.data_decisao) { %>
                                                        <small>
                                                            <%= new Date(requisicao.data_decisao).toLocaleString('pt-BR', {
                                                                timeZone: 'America/Sao_Paulo',
                                                                dateStyle: 'short',
                                                                timeStyle: 'short'
                                                            }) %>
                                                        </small>
                                                    <% } %>
                                                    <% if (requisicao.motivo_rejeicao) { %>
                                                        <small class="compra-motivo-rejeicao">Motivo: <%= requisicao.motivo_rejeicao %></small>
                                                    <% } %>
                                                </div>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } %>
            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <% if (permissoes.aprovarRequisicao) { %>
        <%- include('partials/dialogo-decisao', {
            base: '/requisicoes',
            singular: 'requisição',
            efeitoAprovar: 'Ao aprovar, a quantidade é descontada do estoque.'
        }) %>
    <% } %>

    <script src="/script.js"></script>
    <script src="/selecao-lista.js"></script>

    <script>
        (function () {
            var url = new URL(window.location.href);
            if (url.searchParams.has('mensagem') || url.searchParams.has('erro')) {
                url.searchParams.delete('mensagem');
                url.searchParams.delete('erro');
                history.replaceState(null, '', url.pathname + url.search);
            }
        })();

        ['mensagemSucesso', 'mensagemErro'].forEach(id => {
            const mensagem = document.getElementById(id);

            if (mensagem) {
                setTimeout(() => {
                    mensagem.style.transition = 'opacity 0.5s';
                    mensagem.style.opacity = '0';

                    setTimeout(() => mensagem.remove(), 500);
                }, 3000);
            }
        });
    </script>
</body>
</html>
