
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Requisições | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'requisicoes' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                paginaAtiva: 'requisicoes',
                tituloPagina: 'Requisições'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">OPERAÇÕES</p>
                    <h2>Requisições de materiais</h2>
                    <p>Solicite materiais e acompanhe as decisões das requisições.</p>
                </div>

                <div class="compra-acoes-topo">
                    <% if (permissoes.criarRequisicao) { %>
                        <a href="/requisicoes/nova" class="primary-link">
                            ＋ Nova requisição
                        </a>
                    <% } %>
                    <a href="/requisicoes/editar" class="compra-botao-topo">
                        ✎ Editar
                    </a>
                    <a href="/requisicoes/excluir" class="compra-botao-topo compra-botao-topo-perigo">
                        🗑 Excluir
                    </a>
                </div>
            </section>

            <% if (mensagem) { %>
                <div class="mensagem-sucesso" id="mensagemSucesso" role="status">
                    <%= mensagem %>
                </div>
            <% } %>

            <% if (erro) { %>
                <div class="mensagem-erro" id="mensagemErro" role="alert">
                    <%= erro %>
                </div>
            <% } %>

            <section class="panel-card requisicoes-card">
                <div class="panel-header">
                    <div>
                        <h2>Requisições registradas</h2>
                        <p>Acompanhe o status e as decisões de cada solicitação.</p>
                    </div>
                    <span class="codigo-produto">
                        Total: <%= requisicoes.length %>
                    </span>
                </div>

                <% if (requisicoes.length === 0) { %>
                    <div class="empty-state">
                        <span>✓</span>
                        <p>Nenhuma requisição cadastrada ainda.</p>
                    </div>
                <% } else { %>

                    <div class="table-wrapper tabela-requisicoes">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Produto</th>
                                    <th>Quantidade</th>
                                    <th>Solicitante</th>
                                    <th>Data</th>
                                    <th>Status</th>
                                    <th>Observação</th>
                                    <% if (permissoes.aprovarRequisicao) { %><th>Ações</th><% } %>
                                </tr>
                            </thead>

                            <tbody>
                                <% requisicoes.forEach(requisicao => { %>
                                    <tr>
                                        <td><strong class="compra-codigo">#<%= String(requisicao.id).padStart(5, '0') %></strong></td>

                                        <td>
                                            <%= requisicao.produtos
                                                ? requisicao.produtos.nome
                                                : 'Produto não encontrado' %>
                                        </td>

                                        <td><strong><%= requisicao.quantidade %></strong></td>

                                        <td><%= requisicao.solicitante %></td>

                                        <td>
                                            <%= new Date(requisicao.data_solicitacao)
                                                .toLocaleString('pt-BR') %>
                                        </td>

                                        <td>
                                            <span class="status-requisicao status-<%= requisicao.status.toLowerCase() %>">
                                                <%= requisicao.status %>
                                            </span>
                                        </td>

                                        <td><%= requisicao.observacao || '-' %></td>

                                        <% if (permissoes.aprovarRequisicao) { %>
                                        <td>
                                            <% if (requisicao.status === 'Pendente') { %>
                                                <div class="acoes-requisicao">

                                                    <form
                                                        action="/requisicoes/<%= requisicao.id %>/aprovar"
                                                        method="POST"
                                                    >
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                        <button type="submit" class="botao-aprovar">
                                                            Aprovar
                                                        </button>
                                                    </form>

                                                    <form
                                                        action="/requisicoes/<%= requisicao.id %>/rejeitar"
                                                        method="POST"
                                                        class="form-rejeitar"
                                                    >
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                                        <input
                                                            type="text"
                                                            name="motivo_rejeicao"
                                                            placeholder="Motivo da rejeição"
                                                            aria-label="Motivo da rejeição"
                                                            required
                                                        >

                                                        <button type="submit" class="btn-danger">
                                                            Rejeitar
                                                        </button>
                                                    </form>

                                                </div>
                                            <% } else { %>
                                                <span>Decidida</span>
                                            <% } %>
                                        </td>
                                        <% } %>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } %>
            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <script src="/script.js"></script>

    <script>
        (function () {
            var url = new URL(window.location.href);
            if (url.searchParams.has('mensagem') || url.searchParams.has('erro')) {
                url.searchParams.delete('mensagem');
                url.searchParams.delete('erro');
                history.replaceState(null, '', url.pathname + url.search);
            }
        })();

        ['mensagemSucesso', 'mensagemErro'].forEach(id => {
            const mensagem = document.getElementById(id);

            if (mensagem) {
                setTimeout(() => {
                    mensagem.style.transition = 'opacity 0.5s';
                    mensagem.style.opacity = '0';

                    setTimeout(() => mensagem.remove(), 500);
                }, 3000);
            }
        });
    </script>
</body>
</html>
