
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Requisições | Controle de Estoque</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard-page">

<div class="app-layout">
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">E</div>
            <div>
                <strong>Estoque</strong>
                <small>Controle de materiais</small>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="/">Dashboard</a>
            <a href="/produtos">Produtos</a>
            <a href="/produtos/novo">Cadastrar produto</a>
            <a href="/movimentacoes/nova">Movimentar estoque</a>
            <a href="/movimentacoes">Histórico</a>
            <a href="/relatorios">Relatórios</a>
            <a href="/requisicoes" class="active">Requisições</a>
        </nav>

        <div class="sidebar-footer">Controle de Estoque</div>
    </aside>

    <main class="main-content">
        <header class="page-header">
            <div>
                <h1>Requisições de materiais</h1>
                <p>Solicite materiais e acompanhe as decisões.</p>
            </div>
            <a href="/" class="btn-secondary">Voltar ao início</a>
        </header>

        <% if (mensagem) { %>
            <div class="mensagem-sucesso"><%= mensagem %></div>
        <% } %>

        <% if (erro) { %>
            <div class="mensagem-erro"><%= erro %></div>
        <% } %>

        <section class="panel-card">
            <h2>Nova requisição</h2>

            <form action="/requisicoes" method="POST" class="form-grid">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label for="produto_id">Produto</label>
                    <select name="produto_id" id="produto_id" required>
                        <option value="">Selecione um produto</option>
                        <% produtos.forEach(produto => { %>
                            <option value="<%= produto.id %>">
                                <%= produto.nome %> — Estoque: <%= produto.quantidade %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="quantidade">Quantidade solicitada</label>
                    <input type="number" name="quantidade" id="quantidade"
                           min="1" step="1" required>
                </div>

                <div class="form-group">
                    <label for="solicitante">Nome do solicitante</label>
                    <input type="text" name="solicitante" id="solicitante"
                           maxlength="150" required>
                </div>

                <div class="form-group">
                    <label for="observacao">Observação (opcional)</label>
                    <textarea name="observacao" id="observacao"
                              rows="3" maxlength="1000"></textarea>
                </div>

                <button type="submit" class="btn-primary">
                    Enviar requisição
                </button>
            </form>
        </section>

        <section class="panel-card">
            <h2>Requisições registradas</h2>

            <% if (requisicoes.length === 0) { %>
                <p>Nenhuma requisição cadastrada ainda.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>Produto</th>
                                <th>Quantidade</th>
                                <th>Solicitante</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Observação</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% requisicoes.forEach(requisicao => { %>
                                <tr>
                                    <td>
                                        <%= requisicao.produtos
                                            ? requisicao.produtos.nome
                                            : 'Produto não encontrado' %>
                                    </td>
                                    <td><%= requisicao.quantidade %></td>
                                    <td><%= requisicao.solicitante %></td>
                                    <td>
                                        <%= new Date(requisicao.data_solicitacao)
                                            .toLocaleString('pt-BR') %>
                                    </td>
                                    <td>
                                        <span class="status-requisicao status-<%= requisicao.status.toLowerCase() %>">
                                            <%= requisicao.status %>
                                        </span>
                                    </td>
                                    <td><%= requisicao.observacao || '-' %></td>
                                    <td>
                                        <% if (requisicao.status === 'Pendente') { %>
                                            <form action="/requisicoes/<%= requisicao.id %>/aprovar"
                                                  method="POST">
                                                <button type="submit" class="btn-primary">
                                                    Aprovar
                                                </button>
                                            </form>

                                            <form action="/requisicoes/<%= requisicao.id %>/rejeitar"
                                                  method="POST">
                                                <input type="text" name="motivo_rejeicao"
                                                       placeholder="Motivo da rejeição" required>
                                                <button type="submit" class="btn-danger">
                                                    Rejeitar
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span>Decidida</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
</div>

</body>
</html>
