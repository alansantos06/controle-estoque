<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Permissões de Usuários | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'permissoes' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                paginaAtiva: 'permissoes',
                tituloPagina: 'Permissões de usuários'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">ADMINISTRAÇÃO</p>
                    <h2>Gerenciar acessos</h2>
                    <p>Escolha um usuário para configurar o que ele pode fazer em cada área do sistema.</p>
                </div>
            </section>

            <% if (mensagem) { %>
                <div class="mensagem-sucesso" role="status"><%= mensagem %></div>
            <% } %>

            <% if (erro) { %>
                <div class="mensagem-erro" role="alert"><%= erro %></div>
            <% } %>

            <section class="panel-card">
                <div class="panel-header">
                    <div>
                        <h2>Usuários</h2>
                        <p>Clique em "Configurar" para marcar as permissões de cada usuário.</p>
                    </div>
                    <span class="codigo-produto">Total: <%= usuarios.length %></span>
                </div>

                <% if (usuarios.length === 0) { %>
                    <div class="empty-state">
                        <span>!</span>
                        <p>Nenhum usuário encontrado.</p>
                    </div>
                <% } else { %>
                    <ul class="perm-lista-usuarios">
                        <% usuarios.forEach(usuario => { %>
                            <li>
                                <div class="perm-avatar" aria-hidden="true">
                                    <%= usuario.email.charAt(0).toUpperCase() %>
                                </div>

                                <div class="perm-usuario-info">
                                    <strong>
                                        <%= usuario.email %>
                                        <% if (usuario.ehVoceMesmo) { %><span class="perm-tag">Você</span><% } %>
                                    </strong>

                                    <div class="perm-chips">
                                        <% if (usuario.ehAdministrador) { %>
                                            <span class="perm-chip perm-chip-admin">Administrador · acesso total</span>
                                        <% } else if (usuario.gruposLiberados.length === 0) { %>
                                            <span class="perm-chip perm-chip-vazio">Sem permissões</span>
                                        <% } else { %>
                                            <% usuario.gruposLiberados.forEach(grupo => { %>
                                                <span class="perm-chip"><%= grupo %></span>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                </div>

                                <span class="perm-contador">
                                    <%= usuario.totalMarcadas %>/<%= totalPermissoes %>
                                </span>

                                <a href="/admin/permissoes/<%= usuario.id %>" class="compra-botao-topo">
                                    <%= usuario.ehAdministrador || usuario.ehVoceMesmo ? 'Ver' : 'Configurar' %> →
                                </a>
                            </li>
                        <% }) %>
                    </ul>
                <% } %>
            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <script src="/script.js"></script>
</body>
</html>
