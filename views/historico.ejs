<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Histórico de movimentações | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
    <!-- Aplica o tema salvo antes de desenhar a página (evita piscar) -->
    <script>try { document.documentElement.setAttribute('data-theme', localStorage.getItem('tema-estoque') || 'light'); } catch (e) {}</script>
</head>

<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'historico' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                tituloPagina: 'Histórico de movimentações'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">MOVIMENTAÇÕES</p>
                    <h2>Registro de movimentações</h2>
                    <p>Consulte as entradas e saídas registradas no estoque.</p>
                </div>

                <% if (permissoes.movimentarEstoque) { %>
                    <div class="compra-acoes-topo">
                        <a href="/movimentacoes/nova" class="primary-link">
                            ⇄ Nova movimentação
                        </a>
                    </div>
                <% } %>
            </section>

            <section class="panel-card">

                <div class="panel-header">
                    <div>
                        <h2>Movimentações</h2>
                        <p>Filtre por tipo ou período para encontrar um registro.</p>
                    </div>
                    <span class="codigo-produto">Total: <%= movimentacoes.length %></span>
                </div>

                <form action="/movimentacoes" method="GET" class="filtros-produtos">

                    <div class="campo-produto">
                        <label for="tipo">Tipo de movimentação</label>

                        <select name="tipo" id="tipo">
                            <option value="Todos" <%= tipoSelecionado === 'Todos' ? 'selected' : '' %>>
                                Todas
                            </option>

                            <option value="Entrada" <%= tipoSelecionado === 'Entrada' ? 'selected' : '' %>>
                                Entrada
                            </option>

                            <option value="Saída" <%= tipoSelecionado === 'Saída' ? 'selected' : '' %>>
                                Saída
                            </option>
                        </select>
                    </div>

                    <div class="campo-produto">
                        <label for="dataInicial">Data inicial</label>
                        <input
                            type="date"
                            id="dataInicial"
                            name="dataInicial"
                            value="<%= dataInicial || '' %>"
                        >
                    </div>

                    <div class="campo-produto">
                        <label for="dataFinal">Data final</label>
                        <input
                            type="date"
                            id="dataFinal"
                            name="dataFinal"
                            value="<%= dataFinal || '' %>"
                        >
                    </div>

                    <div class="acoes-filtros">
                        <button type="submit">Filtrar</button>

                        <a href="/movimentacoes" class="botao-secundario">
                            Limpar filtros
                        </a>
                    </div>

                </form>

                <% if (movimentacoes.length === 0) { %>

                    <div class="empty-state">
                        <span>◷</span>
                        <p>Nenhuma movimentação encontrada para esse filtro.</p>
                    </div>

                <% } else { %>

                    <div class="table-wrapper">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Código</th>
                                    <th>Produto</th>
                                    <th>Tipo</th>
                                    <th>Quantidade</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% movimentacoes.forEach(movimentacao => {
                                    // Há registros antigos gravados como "entrada " (minúsculo/espaço)
                                    const entrada = String(movimentacao.tipo || '').trim().toLowerCase() === 'entrada';
                                %>
                                    <tr>
                                        <td class="compra-nowrap">
                                            <%= new Date(movimentacao.data).toLocaleString('pt-BR') %>
                                        </td>

                                        <td>
                                            <span class="codigo-chip">MAT<%= String(movimentacao.produtos.id).padStart(3, '0') %></span>
                                        </td>

                                        <td>
                                            <strong><%= movimentacao.produtos.nome %></strong>
                                        </td>

                                        <td>
                                            <span class="<%= entrada ? 'status-entrada' : 'status-saida' %>">
                                                <%= entrada ? '↑ Entrada' : '↓ Saída' %>
                                            </span>
                                        </td>

                                        <td>
                                            <strong class="<%= entrada ? 'quantidade-entrada' : 'quantidade-saida' %>">
                                                <%= entrada ? '+' : '−' %><%= movimentacao.quantidade %>
                                            </strong>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } %>

                <div class="acoes-formulario">
                    <a href="/" class="botao-secundario">Voltar ao início</a>
                    <a href="/produtos" class="botao-secundario">Voltar para produtos</a>
                </div>

            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <script src="/script.js"></script>
</body>
</html>
