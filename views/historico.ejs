<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Histórico - Controle de Estoque</title>
</head>
<body>

    <h1>Histórico de Movimentações</h1>
    <a href="/">
        <button type="button">Voltar ao início</button>
    </a>

    <form action="/movimentacoes" method="GET">

        <label for="tipo">Filtrar por tipo:</label>
        

        <select name="tipo" id="tipo">
            <option value="Todos" <%= tipoSelecionado === 'Todos' ? 'selected' : '' %>>
                Todos
            </option>

            <option value="Entrada" <%= tipoSelecionado === 'Entrada' ? 'selected' : '' %>>
                Entrada
            </option>

            <option value="Saída" <%= tipoSelecionado === 'Saída' ? 'selected' : '' %>>
                Saída
            </option>
        </select>

        <button type="submit">Filtrar</button>

        <a href="/movimentacoes">
            <button type="button">Limpar filtro</button>
        </a>

    </form>

    <br>

    <table border="1">
        <thead>
            <tr>
                <th>Data</th>
                <th>Código</th>
                <th>Produto</th>
                <th>Tipo</th>
                <th>Quantidade</th>
            </tr>
        </thead>

        <tbody>

            <% movimentacoes.forEach(movimentacao => { %>

                <tr>
                    <td>
                        <%= new Date(movimentacao.data).toLocaleString('pt-BR') %>
                    </td>

                    <td>
                        MAT<%= String(movimentacao.produtos.id).padStart(3, '0') %>
                    </td>

                    <td>
                        <%= movimentacao.produtos.nome %>
                    </td>

                    <td>
                        <%= movimentacao.tipo %>
                    </td>

                    <td>
                        <%= movimentacao.quantidade %>
                    </td>
                </tr>

            <% }) %>

        </tbody>
    </table>

    <br>

    <a href="/produtos">Voltar para produtos</a>

</body>
</html>