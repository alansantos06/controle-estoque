
<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Relatórios | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
    <!-- Aplica o tema salvo antes de desenhar a página (evita piscar) -->
    <script>try { document.documentElement.setAttribute('data-theme', localStorage.getItem('tema-estoque') || 'light'); } catch (e) {}</script>

    <style>
        .relatorios-conteudo {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .relatorio-card {
            min-width: 0;
            padding: 24px;
            border-radius: 14px;
            background: var(--card-bg, #ffffff);
            border: 1px solid var(--border-color, #e5e7eb);
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .relatorio-card h2 {
            margin: 0 0 10px;
            font-size: 1.2rem;
        }

        .relatorio-card > p {
            margin: 0 0 20px;
            line-height: 1.6;
            color: var(--text-secondary, #64748b);
        }

        .filtros-relatorio {
            display: flex;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 16px;
        }

        .filtro-campo {
            display: flex;
            flex: 1 1 190px;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }

        .filtro-campo label {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .filtro-campo input {
            width: 100%;
            min-height: 42px;
            box-sizing: border-box;
            padding: 9px 12px;
            border: 1px solid var(--border-color, #d1d5db);
            border-radius: 8px;
            background: var(--input-bg, #ffffff);
            color: inherit;
            font: inherit;
        }

        .acoes-relatorio {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }

        .acoes-relatorio a {
            display: inline-flex;
            min-height: 42px;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            padding: 10px 15px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
        }

        .relatorio-resumo {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .resumo-item {
            min-width: 0;
            padding: 22px;
            border: 1px solid var(--border-color, #e5e7eb);
            border-left: 4px solid #64748b;
            border-radius: 12px;
            background: var(--card-bg, #ffffff);
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
        }

        .resumo-item.entradas {
            border-left-color: #22c55e;
        }

        .resumo-item.saidas {
            border-left-color: #ef4444;
        }

        .resumo-item strong {
            display: block;
            margin-bottom: 12px;
            font-size: 0.88rem;
            color: var(--text-secondary, #64748b);
        }

        .resumo-valor {
            font-size: clamp(1.5rem, 2.5vw, 2rem);
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .legenda-mensal {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin: 20px 0 10px;
        }

        .legenda-mensal span {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .marcador-entrada,
        .marcador-saida {
            display: inline-block;
            width: 11px;
            height: 11px;
            border-radius: 3px;
        }

        .marcador-entrada,
        .grafico-entrada {
            background: #16a34a;
        }

        .marcador-saida,
        .grafico-saida {
            background: #dc2626;
        }

        .grafico-meses-horizontal {
            display: flex;
            align-items: stretch;
            gap: 18px;
            width: 100%;
            min-height: 280px;
            padding: 20px 8px 0;
            box-sizing: border-box;
            overflow-x: auto;
        }

        .coluna-mes {
            display: flex;
            flex: 1 0 90px;
            flex-direction: column;
            min-width: 90px;
            text-align: center;
        }

        .barras-mes {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 8px;
            height: 230px;
            border-bottom: 1px solid var(--border-color, #d1d5db);
            background-image: linear-gradient(
                to top,
                transparent 24%,
                var(--chart-grid, #e5e7eb) 25%,
                transparent 25%,
                transparent 49%,
                var(--chart-grid, #e5e7eb) 50%,
                transparent 50%,
                transparent 74%,
                var(--chart-grid, #e5e7eb) 75%,
                transparent 75%
            );
        }

        .coluna-barra {
            display: flex;
            flex: 0 1 42px;
            align-items: flex-start;
            justify-content: center;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            border-radius: 5px 5px 0 0;
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
        }

        .coluna-barra span {
            padding-top: 5px;
            overflow-wrap: anywhere;
        }

        .nome-mes {
            padding-top: 10px;
            font-size: 12px;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .tabela-responsiva {
            width: 100%;
            overflow-x: auto;
        }

        .tabela-responsiva table {
            width: 100%;
            border-collapse: collapse;
        }

        .tabela-responsiva th,
        .tabela-responsiva td {
            padding: 13px 14px;
            text-align: left;
            border-bottom: 1px solid var(--border-color, #e5e7eb);
        }

        .tabela-responsiva th {
            background: var(--table-header-bg, #f8fafc);
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .tabela-responsiva tbody tr:hover {
            background: var(--table-hover-bg, rgba(148, 163, 184, 0.08));
        }

        .ranking-item {
            margin: 24px 0;
        }

        .ranking-legenda {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 9px;
        }

        .ranking-posicao {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            margin-right: 7px;
            border-radius: 8px;
            background: var(--badge-bg, #ecfdf5);
            color: var(--badge-color, #166534);
            font-weight: 700;
        }

        .grafico-fundo {
            width: 100%;
            height: 12px;
            overflow: hidden;
            border-radius: 20px;
            background: var(--chart-track, #e5e7eb);
        }

        .grafico-barra {
            height: 100%;
            border-radius: 20px;
            transition: width 0.35s ease;
        }

        .grafico-ranking {
            background: #22a06b;
        }

        .estoque-baixo {
            color: #ef4444;
            font-weight: 700;
        }

        .estoque-normal {
            color: #22c55e;
            font-weight: 600;
        }

        .relatorio-vazio {
            padding: 16px;
            border-radius: 8px;
            background: var(--table-header-bg, #f8fafc);
            color: var(--text-secondary, #64748b);
        }

        .navegacao-relatorio {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 0 0 24px;
        }

        .navegacao-relatorio a {
            text-decoration: none;
            font-weight: 600;
        }

        html[data-theme="dark"] .relatorio-card,
        html[data-theme="dark"] .resumo-item {
            background: var(--card-bg, #192b23);
        }

        html[data-theme="dark"] .barras-mes {
            --chart-grid: #34483d;
        }

        html[data-theme="dark"] .grafico-fundo {
            --chart-track: #34483d;
        }

        html[data-theme="dark"] .ranking-posicao {
            --badge-bg: #203b30;
            --badge-color: #bbf7d0;
        }

        @media (max-width: 1000px) {
            .relatorio-resumo {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 600px) {
            .relatorio-card {
                padding: 17px;
            }

            .relatorio-resumo {
                grid-template-columns: 1fr;
            }

            .resumo-item {
                padding: 18px;
            }

            .grafico-meses-horizontal {
                gap: 12px;
            }

            .coluna-mes {
                flex-basis: 78px;
                min-width: 78px;
            }

            .barras-mes {
                height: 190px;
                gap: 5px;
            }

            .coluna-barra {
                font-size: 10px;
            }

            .tabela-responsiva th,
            .tabela-responsiva td {
                padding: 10px;
                white-space: nowrap;
            }
        }
    </style>
</head>

<body class="dashboard-page">
    <div class="app-layout">
        <%- include('partials/sidebar', { paginaAtiva: 'relatorios' }) %>

        <main class="dashboard-main">
            <%- include('partials/header', { paginaAtiva: 'relatorios', tituloPagina: 'Relatórios' }) %>

            <div class="relatorios-conteudo">

                <section class="welcome-panel">
                    <div>
                        <p class="welcome-label">ANÁLISES</p>
                        <h2>Relatórios do estoque</h2>
                        <p>Acompanhe o volume de entradas e saídas e exporte os dados do período.</p>
                    </div>

                    <div class="compra-acoes-topo">
                        <a href="/relatorios/exportar?dataInicio=<%= encodeURIComponent(dataInicio || '') %>&dataFim=<%= encodeURIComponent(dataFim || '') %>" class="primary-link">
                            ⤓ Baixar relatório CSV
                        </a>
                    </div>
                </section>

                <section class="relatorio-card">
                    <h2>Filtrar período</h2>
                    <p>Selecione as datas para analisar as movimentações do estoque.</p>

                    <form action="/relatorios" method="GET">
                        <div class="filtros-relatorio">
                            <div class="filtro-campo">
                                <label for="dataInicio">Data inicial</label>
                                <input type="date" id="dataInicio" name="dataInicio"
                                    value="<%= dataInicio || '' %>">
                            </div>

                            <div class="filtro-campo">
                                <label for="dataFim">Data final</label>
                                <input type="date" id="dataFim" name="dataFim"
                                    value="<%= dataFim || '' %>">
                            </div>

                            <div class="acoes-relatorio">
                                <button type="submit" class="botao">Aplicar filtros</button>
                                <a href="/relatorios" class="botao-secundario">Limpar filtros</a>
                            </div>
                        </div>
                    </form>
                </section>

                <section class="relatorio-resumo">
                    <div class="resumo-item">
                        <strong>⇄ Total de movimentações</strong>
                        <div class="resumo-valor"><%= movimentacoes.length %></div>
                    </div>

                    <div class="resumo-item entradas">
                        <strong>↑ Unidades que entraram</strong>
                        <div class="resumo-valor"><%= totalEntradas %></div>
                    </div>

                    <div class="resumo-item saidas">
                        <strong>↓ Unidades que saíram</strong>
                        <div class="resumo-valor"><%= totalSaidas %></div>
                    </div>

                    <div class="resumo-item">
                        <strong>▤ Produtos cadastrados</strong>
                        <div class="resumo-valor"><%= produtos.length %></div>
                    </div>
                </section>

                <section class="relatorio-card">
                    <h2>Entradas x Saídas por mês</h2>
                    <p>Compare as quantidades de entradas e saídas em cada mês.</p>

                    <div class="legenda-mensal">
                        <span><span class="marcador-entrada"></span> Entradas</span>
                        <span><span class="marcador-saida"></span> Saídas</span>
                    </div>

                    <% if (movimentacoesPorMes.length === 0) { %>
                        <p class="relatorio-vazio">Não existem movimentações no período selecionado.</p>
                    <% } else { %>
                        <%
                            const maiorMovimentoMensal = Math.max(
                                1,
                                ...movimentacoesPorMes.map(m =>
                                    Math.max(m.entradas, m.saidas)
                                )
                            );
                        %>

                        <div class="grafico-meses-horizontal">
                            <% movimentacoesPorMes.forEach(m => { %>
                                <div class="coluna-mes">
                                    <div class="barras-mes">
                                        <div
                                            class="coluna-barra grafico-entrada"
                                            style="height: <%= (m.entradas / maiorMovimentoMensal) * 100 %>%"
                                            title="Entradas: <%= m.entradas %>">
                                            <span><%= m.entradas %></span>
                                        </div>

                                        <div
                                            class="coluna-barra grafico-saida"
                                            style="height: <%= (m.saidas / maiorMovimentoMensal) * 100 %>%"
                                            title="Saídas: <%= m.saidas %>">
                                            <span><%= m.saidas %></span>
                                        </div>
                                    </div>

                                    <div class="nome-mes"><%= m.nomeMes %></div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </section>

                <nav class="navegacao-relatorio">
                    <a href="/" class="botao-secundario">← Voltar ao início</a>
                    <a href="/produtos" class="botao-secundario">▤ Ver produtos</a>
                    <a href="/movimentacoes" class="botao-secundario">◷ Ver histórico</a>
                </nav>
            </div>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>
        </main>
    </div>

    <script src="/script.js"></script>
</body>
</html>
