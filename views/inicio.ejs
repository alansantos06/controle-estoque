
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Controle de Estoque</title>
    <link rel="stylesheet" href="/style.css">

    <style>
        /* Estrutura geral */
        .dashboard-container {
            width: calc(100% - 40px);
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px 0 40px;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-bottom: 28px;
        }

        .dashboard-header h1 {
            margin: 0;
            font-size: 27px;
        }

        /* Menu hambúrguer */
        .menu-container {
            position: relative;
        }

        .menu-botao {
            width: 46px;
            height: 42px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            background: #ffffff;
            color: #1f2937;
            font-size: 25px;
            cursor: pointer;
        }

        .menu-botao:hover {
            background: #f3f4f6;
        }

        .menu-dropdown {
            display: none;
            position: absolute;
            top: 50px;
            right: 0;
            width: 240px;
            padding: 8px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
            z-index: 100;
        }

        .menu-dropdown.aberto {
            display: block;
        }

        .menu-dropdown a {
            display: block;
            padding: 12px;
            border-radius: 6px;
            color: #1f2937;
            text-decoration: none;
        }

        .menu-dropdown a:hover {
            background: #f3f4f6;
        }

        /* Indicadores */
        .dashboard-subtitulo {
            margin: 0 0 18px;
            font-size: 21px;
        }

        .dashboard-cards {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .dashboard-card {
            padding: 22px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
            min-width: 0;
        }

        .dashboard-card h3 {
            margin: 0 0 12px;
            color: #64748b;
            font-size: 14px;
            font-weight: 500;
        }

        .dashboard-numero {
            font-size: 30px;
            font-weight: 700;
            color: #1f2937;
        }

        .dashboard-card.alerta {
            border-left: 4px solid #f59e0b;
        }

        /* Conteúdo abaixo dos indicadores */
        .dashboard-conteudo {
            display: grid;
            grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr);
            align-items: start;
            gap: 24px;
        }

        .painel-secundario {
            min-width: 0;
            padding: 22px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        .painel-secundario h2 {
            margin: 0 0 8px;
            font-size: 19px;
        }

        .descricao-secundaria {
            margin: 0 0 18px;
            color: #64748b;
            font-size: 13px;
            line-height: 1.5;
        }

        /* Tabela discreta de estoque baixo */
        .tabela-dashboard {
            width: 100%;
            overflow-x: auto;
        }

        .tabela-dashboard table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        .tabela-dashboard th,
        .tabela-dashboard td {
            padding: 12px 10px;
            text-align: left;
            border-bottom: 1px solid #e5e7eb;
        }

        .tabela-dashboard th {
            background: #f8fafc;
            color: #64748b;
            font-weight: 600;
        }

        .situacao-estoque {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 5px;
            background: #fff7ed;
            color: #9a3412;
            font-size: 12px;
            white-space: nowrap;
        }

        .situacao-estoque.esgotado {
            background: #fef2f2;
            color: #b91c1c;
        }

        .aviso-sem-alertas {
            padding: 12px;
            border-radius: 7px;
            background: #f0fdf4;
            color: #166534;
            font-size: 14px;
        }

        /* Navegação secundária */
        .atalhos-dashboard {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: 16px;
        }

        .atalhos-dashboard a {
            padding: 11px 12px;
            border-radius: 6px;
            background: #f8fafc;
            color: #1d4ed8;
            font-size: 14px;
            text-decoration: none;
        }

        .atalhos-dashboard a:hover {
            background: #eff6ff;
        }

        @media (max-width: 800px) {
            .dashboard-conteudo {
                grid-template-columns: 1fr;
            }

            .dashboard-cards {
                gap: 12px;
            }

            .dashboard-card {
                padding: 16px;
            }
        }

        @media (max-width: 560px) {
            .dashboard-container {
                width: calc(100% - 28px);
                padding-top: 16px;
            }

            .dashboard-header h1 {
                font-size: 21px;
            }

            .dashboard-cards {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .dashboard-card {
                padding: 15px 18px;
            }

            .dashboard-card h3 {
                margin-bottom: 6px;
            }

            .dashboard-numero {
                font-size: 25px;
            }

            .painel-secundario {
                padding: 16px;
            }

            .tabela-dashboard th,
            .tabela-dashboard td {
                white-space: nowrap;
            }
        }
    </style>
</head>

<body>
    <main class="dashboard-container">

        <!-- Cabeçalho e menu -->
        <header class="dashboard-header">
            <h1>Sistema de Controle de Estoque</h1>

            <div class="menu-container">
                <button
                    type="button"
                    class="menu-botao"
                    id="menuBotao"
                    aria-label="Abrir menu de navegação"
                    aria-expanded="false"
                    aria-controls="menuDropdown"
                >
                    ☰
                </button>

                <nav class="menu-dropdown" id="menuDropdown">
                    <a href="/">Início</a>
                    <a href="/produtos">Gerenciar produtos</a>
                    <a href="/produtos/novo">Cadastrar produto</a>
                    <a href="/movimentacoes/nova">Registrar entrada ou saída</a>
                    <a href="/movimentacoes">Histórico de movimentações</a>
                    <a href="/relatorios">Relatórios de estoque</a>
                </nav>
            </div>
        </header>

        <!-- Indicadores principais -->
        <section>
            <h2 class="dashboard-subtitulo">Resumo do estoque</h2>

            <div class="dashboard-cards">
                <article class="dashboard-card">
                    <h3>Produtos cadastrados</h3>
                    <div class="dashboard-numero">
                        <%= totalProdutos %>
                    </div>
                </article>

                <article class="dashboard-card">
                    <h3>Itens em estoque</h3>
                    <div class="dashboard-numero">
                        <%= totalEstoque %>
                    </div>
                </article>

                <article class="dashboard-card alerta">
                    <h3>Produtos com estoque baixo</h3>
                    <div class="dashboard-numero">
                        <%= produtosEstoqueBaixo.length %>
                    </div>
                </article>
            </div>
        </section>

        <!-- Conteúdo secundário -->
        <div class="dashboard-conteudo">

            <!-- Estoque baixo: informação secundária -->
            <section class="painel-secundario">
                <h2>Estoque baixo</h2>

                <p class="descricao-secundaria">
                    Produtos que podem precisar de reposição.
                </p>

                <% if (produtosEstoqueBaixo.length === 0) { %>

                    <div class="aviso-sem-alertas">
                        Nenhum produto precisa de reposição no momento.
                    </div>

                <% } else { %>

                    <div class="tabela-dashboard">
                        <table>
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Produto</th>
                                    <th>Atual</th>
                                    <th>Mínimo</th>
                                    <th>Situação</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% produtosEstoqueBaixo.forEach(produto => { %>
                                    <tr>
                                        <td>
                                            <%= 'MAT' + String(produto.id).padStart(3, '0') %>
                                        </td>

                                        <td><%= produto.nome %></td>

                                        <td><%= produto.quantidade %></td>

                                        <td><%= produto.estoque_minimo %></td>

                                        <td>
                                            <% if (Number(produto.quantidade) === 0) { %>
                                                <span class="situacao-estoque esgotado">
                                                    Esgotado
                                                </span>
                                            <% } else { %>
                                                <span class="situacao-estoque">
                                                    Reposição
                                                </span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } %>
            </section>

            <!-- Atalhos rápidos -->
            <aside class="painel-secundario">
                <h2>Acesso rápido</h2>

                <p class="descricao-secundaria">
                    Acesse as principais funções do sistema.
                </p>

                <nav class="atalhos-dashboard">
                    <a href="/produtos">Gerenciar produtos</a>
                    <a href="/produtos/novo">Cadastrar novo produto</a>
                    <a href="/movimentacoes/nova">Registrar entrada ou saída</a>
                    <a href="/movimentacoes">Ver histórico</a>
                    <a href="/relatorios">Ver relatórios</a>
                </nav>
            </aside>

        </div>
    </main>

    <script>
        const menuBotao = document.getElementById('menuBotao');
        const menuDropdown = document.getElementById('menuDropdown');

        menuBotao.addEventListener('click', () => {
            const aberto = menuDropdown.classList.toggle('aberto');

            menuBotao.setAttribute('aria-expanded', aberto);
            menuBotao.setAttribute(
                'aria-label',
                aberto ? 'Fechar menu de navegação' : 'Abrir menu de navegação'
            );
        });

        // Fecha o menu ao clicar fora dele.
        document.addEventListener('click', (evento) => {
            if (
                !menuDropdown.contains(evento.target) &&
                !menuBotao.contains(evento.target)
            ) {
                menuDropdown.classList.remove('aberto');
                menuBotao.setAttribute('aria-expanded', 'false');
                menuBotao.setAttribute('aria-label', 'Abrir menu de navegação');
            }
        });

        // Fecha o menu ao pressionar Esc.
        document.addEventListener('keydown', (evento) => {
            if (evento.key === 'Escape') {
                menuDropdown.classList.remove('aberto');
                menuBotao.setAttribute('aria-expanded', 'false');
                menuBotao.setAttribute('aria-label', 'Abrir menu de navegação');
                menuBotao.focus();
            }
        });
    </script>
</body>
</html>
