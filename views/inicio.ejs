
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'inicio' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                paginaAtiva: 'inicio',
                tituloPagina: 'Dashboard'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">VISÃO GERAL</p>
                    <h2>Controle de estoque</h2>
                    <p>Acompanhe seus produtos e as principais informações do almoxarifado.</p>
                </div>

                <a href="/produtos/novo" class="primary-link">
                    ＋ Cadastrar produto
                </a>
            </section>

            <section class="dashboard-cards">

                <article class="dashboard-card">
                    <div class="card-icon produtos-icon">▤</div>
                    <div>
                        <p class="card-label">Produtos cadastrados</p>
                        <h2><%= totalProdutos %></h2>
                        <small>Produtos registrados no sistema</small>
                    </div>
                </article>

                <article class="dashboard-card">
                    <div class="card-icon estoque-icon">▦</div>
                    <div>
                        <p class="card-label">Itens em estoque</p>
                        <h2><%= totalEstoque %></h2>
                        <small>Quantidade total disponível</small>
                    </div>
                </article>

                <article class="dashboard-card card-alerta">
                    <div class="card-icon alerta-icon">!</div>
                    <div>
                        <p class="card-label">Estoque baixo</p>
                        <h2><%= produtosEstoqueBaixo.length %></h2>
                        <small>Produtos que precisam de atenção</small>
                    </div>
                </article>

            </section>

            <section class="dashboard-content-grid">
                <div class="panel-card">

                    <div class="panel-header">
                        <div>
                            <h2>Atenção ao estoque</h2>
                            <p>Produtos que estão no mínimo ou abaixo dele.</p>
                        </div>

                        <a href="/produtos" class="text-link">Ver produtos →</a>
                    </div>

                    <% if (produtosEstoqueBaixo.length === 0) { %>

                        <div class="empty-state">
                            <span>✓</span>
                            <p>Nenhum produto com estoque baixo.</p>
                        </div>

                    <% } else { %>

                        <div class="table-wrapper">
                            <table class="dashboard-table">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Produto</th>
                                        <th>Quantidade</th>
                                        <th>Situação</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% produtosEstoqueBaixo.forEach(produto => { %>
                                        <tr>
                                            <td>
                                                MAT<%= String(produto.id).padStart(3, '0') %>
                                            </td>

                                            <td><%= produto.nome %></td>

                                            <td>
                                                <strong><%= produto.quantidade %></strong>
                                            </td>

                                            <td>
                                                <span class="stock-badge">Estoque baixo</span>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                    <% } %>

                </div>
            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <script src="/script.js"></script>
</body>
</html>
