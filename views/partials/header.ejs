
<header class="topbar">
    <div class="topbar-left">
        <button
            type="button"
            id="menuBotao"
            class="icon-button menu-mobile-button"
            aria-label="Abrir menu"
            aria-expanded="false"
        >
            ☰
        </button>

        <div>
            <p class="breadcrumb">
                Início / <%= tituloPagina %>
            </p>

            <h1><%= tituloPagina %></h1>
        </div>
    </div>

    <button
        type="button"
        id="temaBotao"
        class="theme-button"
    >
        <span id="temaIcone">🌙</span>
        <span id="temaTexto">Modo escuro</span>
    </button>
</header>
