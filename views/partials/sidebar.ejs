<% const p = typeof permissoes !== 'undefined' ? permissoes : {}; %>
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon">E</div>
        <div>
            <strong>EstoquePro</strong>
            <small>Gestão de almoxarifado</small>
        </div>
    </div>

    <div class="sidebar-section-title">MENU PRINCIPAL</div>

    <nav class="sidebar-nav">
        <a href="/" class="menu-link <%= paginaAtiva === 'inicio' ? 'ativo' : '' %>">
            <span class="menu-icon">▦</span>
            Dashboard
        </a>

        <a href="/produtos" class="menu-link <%= paginaAtiva === 'produtos' ? 'ativo' : '' %>">
            <span class="menu-icon">▤</span>
            Produtos
        </a>

        <% if (p.cadastrarProdutos) { %>
            <a href="/produtos/novo" class="menu-link <%= paginaAtiva === 'novo-produto' ? 'ativo' : '' %>">
                <span class="menu-icon">＋</span>
                Cadastrar produto
            </a>
        <% } %>

        <% if (p.movimentarEstoque) { %>
            <a href="/movimentacoes/nova" class="menu-link <%= paginaAtiva === 'movimentacao' ? 'ativo' : '' %>">
                <span class="menu-icon">⇄</span>
                Ajuste de estoque
            </a>
        <% } %>

        <a href="/movimentacoes" class="menu-link <%= paginaAtiva === 'historico' ? 'ativo' : '' %>">
            <span class="menu-icon">◷</span>
            Histórico
        </a>

        <a href="/relatorios" class="menu-link <%= paginaAtiva === 'relatorios' ? 'ativo' : '' %>">
            <span class="menu-icon">▥</span>
            Relatórios
        </a>
    </nav>

    <div class="sidebar-section-title">OPERAÇÕES</div>

    <nav class="sidebar-nav">
        <% if (p.criarRequisicao || p.aprovarRequisicao) { %>
            <a href="/requisicoes" class="menu-link <%= paginaAtiva === 'requisicoes' ? 'ativo' : '' %>">
                <span class="menu-icon">⇥</span>
                Requisições
            </a>
        <% } %>

        <% if (p.criarSolicitacaoCompra || p.aprovarSolicitacaoCompra) { %>
            <a href="/compras" class="menu-link <%= paginaAtiva === 'compras' ? 'ativo' : '' %>">
                <span class="menu-icon">🛒</span>
                Solicitações de compra
            </a>
        <% } %>

        <% if (p.gerenciarPermissoes) { %>
            <a href="/admin/permissoes" class="menu-link <%= paginaAtiva === 'permissoes' ? 'ativo' : '' %>">
                <span class="menu-icon">♙</span>
                Permissões de usuários
            </a>
        <% } %>
    </nav>

    <div class="sidebar-footer">
        <span class="status-dot"></span>
        Sistema de estoque
        <small>Versão MVP</small>

        <form action="/logout" method="POST" class="logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="logout-button">
                ⇥ Sair do sistema
            </button>
        </form>
    </div>
</aside>
