
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar produto | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
    <!-- Aplica o tema salvo antes de desenhar a página (evita piscar) -->
    <script>try { document.documentElement.setAttribute('data-theme', localStorage.getItem('tema-estoque') || 'light'); } catch (e) {}</script>
</head>
<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'produtos' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                paginaAtiva: 'produtos',
                tituloPagina: 'Editar produto'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">CADASTRO DE MATERIAIS</p>
                    <h2>Editar produto</h2>
                    <p>Atualize as informações do produto selecionado.</p>
                </div>

                <a href="/produtos" class="botao-secundario">
                    ← Voltar para produtos
                </a>
            </section>

            <section class="panel-card formulario-produto">

                <div class="panel-header">
                    <div>
                        <h2>Dados do produto</h2>
                        <p>Confira os dados antes de salvar as alterações.</p>
                    </div>
                    <span class="codigo-produto">
                        MAT<%= String(produto.id).padStart(3, '0') %>
                    </span>
                </div>

                <% if (erro) {
                    let textoErro = '';

                    if (erro === 'nome') {
                        textoErro = 'O nome do produto é obrigatório.';
                    } else if (erro === 'numeros') {
                        textoErro = 'Os valores de estoque devem ser números válidos.';
                    } else if (erro === 'negativo') {
                        textoErro = 'Os valores de estoque não podem ser negativos.';
                    } else if (erro === 'limites') {
                        textoErro = 'O estoque máximo não pode ser menor que o mínimo.';
                    } else if (erro === 'servidor') {
                        textoErro = 'Não foi possível atualizar o produto. Tente novamente.';
                    }
                %>

                    <% if (textoErro) { %>
                        <div class="mensagem-erro" id="mensagemErro" role="alert">
                            <%= textoErro %>
                        </div>

                        <script>
                            setTimeout(() => {
                                const mensagem = document.getElementById('mensagemErro');

                                if (mensagem) {
                                    mensagem.style.transition = 'opacity 0.5s';
                                    mensagem.style.opacity = '0';

                                    setTimeout(() => mensagem.remove(), 500);
                                }
                            }, 3000);
                        </script>
                    <% } %>

                <% } %>

                <form action="/produtos/<%= produto.id %>/editar" method="POST"
                      class="formulario-edicao">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="campo-formulario">
                        <label for="nome">Nome do produto</label>
                        <input
                            type="text"
                            id="nome"
                            name="nome"
                            value="<%= produto.nome %>"
                            placeholder="Digite o nome do produto"
                            required
                        >
                    </div>

                    <div class="campos-formulario-grid">
                        <div class="campo-formulario">
                            <label for="estoque_minimo">Estoque mínimo</label>
                            <input
                                type="number"
                                id="estoque_minimo"
                                name="estoque_minimo"
                                value="<%= produto.estoque_minimo %>"
                                min="0"
                                required
                            >
                            <small>Quantidade mínima desejada no estoque.</small>
                        </div>

                        <div class="campo-formulario">
                            <label for="estoque_maximo">Estoque máximo</label>
                            <input
                                type="number"
                                id="estoque_maximo"
                                name="estoque_maximo"
                                value="<%= produto.estoque_maximo %>"
                                min="0"
                                required
                            >
                            <small>Limite máximo planejado para o produto.</small>
                        </div>
                    </div>

                    <div class="informacao-estoque">
                        <span>Quantidade atual em estoque</span>
                        <strong><%= produto.quantidade %></strong>
                        <small>A edição destes dados não altera a quantidade atual.</small>
                    </div>

                    <div class="acoes-formulario">
                        <a href="/produtos" class="botao-secundario">
                            Cancelar
                        </a>

                        <button type="submit" class="primary-link botao-salvar">
                            Salvar alterações
                        </button>
                    </div>

                </form>
            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <script src="/script.js"></script>
</body>
</html>
