<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/style.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Novo Produto</title>
</head>

<body>

    <h1>Cadastrar Novo Produto</h1>

    
    <% if (erro === 'nome') { %>
        <p class="mensagem-erro" id="mensagemErro">
            O nome do produto é obrigatório.
        </p>
    <% } else if (erro === 'numeros') { %>
        <p class="mensagem-erro" id="mensagemErro">
            Os valores de estoque devem ser números válidos.
        </p>
    <% } else if (erro === 'negativo') { %>
        <p class="mensagem-erro" id="mensagemErro">
            Os valores de estoque não podem ser negativos.
        </p>
    <% } else if (erro === 'limites') { %>
        <p class="mensagem-erro" id="mensagemErro">
            O estoque máximo não pode ser menor que o estoque mínimo.
        </p>
    <% } else if (erro === 'servidor') { %>
        <p class="mensagem-erro" id="mensagemErro">
            Não foi possível cadastrar o produto. Tente novamente.
        </p>
    <% } %>

    <% if (erro) { %>
        <script>
            setTimeout(() => {
                const mensagem = document.getElementById('mensagemErro');

                if (mensagem) {
                    mensagem.style.transition = 'opacity 0.5s';
                    mensagem.style.opacity = '0';

                    setTimeout(() => mensagem.remove(), 500);
                }
            }, 3000);
        </script>
    <% } %>


    <form action="/produtos" method="POST">

        <label for="nome">Nome do produto:</label>
        <input type="text" id="nome" name="nome" required>

        <br><br>

        <label for="quantidade">Quantidade inicial:</label>
        <input type="number" id="quantidade" name="quantidade" min="0" required>

        <br><br>

        <label for="estoque_minimo">Estoque mínimo:</label>
        <input type="number" id="estoque_minimo" name="estoque_minimo" min="0" required>

        <br><br>

        <label for="estoque_maximo">Estoque máximo:</label>
        <input type="number" id="estoque_maximo" name="estoque_maximo" min="0" required>

        <br><br>

        <button type="submit">Cadastrar</button>

    </form>

    <br>

    <a href="/produtos">Voltar para produtos</a>

</body>
</html>