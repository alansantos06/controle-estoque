<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos | EstoquePro</title>
    <link rel="stylesheet" href="/style.css">
    <!-- Aplica o tema salvo antes de desenhar a página (evita piscar) -->
    <script>try { document.documentElement.setAttribute('data-theme', localStorage.getItem('tema-estoque') || 'light'); } catch (e) {}</script>
</head>

<body class="dashboard-page">
    <div class="app-layout">

        <%- include('partials/sidebar', { paginaAtiva: 'produtos' }) %>

        <main class="dashboard-main">

            <%- include('partials/header', {
                tituloPagina: 'Produtos'
            }) %>

            <section class="welcome-panel">
                <div>
                    <p class="welcome-label">ALMOXARIFADO</p>
                    <h2>Produtos cadastrados</h2>
                    <p>Consulte, pesquise e gerencie os materiais do almoxarifado.</p>
                </div>

                <% if (permissoes.cadastrarProdutos || permissoes.movimentarEstoque) { %>
                    <div class="compra-acoes-topo">
                        <% if (permissoes.cadastrarProdutos) { %>
                            <a href="/produtos/novo" class="primary-link">
                                ＋ Novo produto
                            </a>
                        <% } %>
                        <% if (permissoes.movimentarEstoque) { %>
                            <a href="/movimentacoes/nova" class="compra-botao-topo">
                                ⇄ Nova movimentação
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </section>

            <%
                let textoMensagem = '';
                let classeMensagem = '';

                if (mensagem === 'editado') {
                    textoMensagem = 'Produto atualizado com sucesso!';
                    classeMensagem = 'mensagem-sucesso';
                } else if (mensagem === 'excluido') {
                    textoMensagem = 'Produto excluído com sucesso!';
                    classeMensagem = 'mensagem-sucesso';
                } else if (mensagem === 'entradaRegistrada') {
                    textoMensagem = 'Entrada registrada com sucesso!';
                    classeMensagem = 'mensagem-sucesso';
                } else if (mensagem === 'saidaRegistrada') {
                    textoMensagem = 'Saída registrada com sucesso!';
                    classeMensagem = 'mensagem-sucesso';
                } else if (mensagem === 'cadastrado') {
                    textoMensagem = 'Produto cadastrado com sucesso!';
                    classeMensagem = 'mensagem-sucesso';
                } else if (erro === 'possuiMovimentacoes') {
                    textoMensagem = 'Não é possível excluir este produto porque ele possui movimentações.';
                    classeMensagem = 'mensagem-erro';
                } else if (erro === 'excluir') {
                    textoMensagem = 'Não foi possível excluir o produto. Tente novamente.';
                    classeMensagem = 'mensagem-erro';
                }
            %>

            <% if (textoMensagem) { %>
                <div class="<%= classeMensagem %>" id="mensagemProdutos" role="status">
                    <%= textoMensagem %>
                </div>
            <% } %>

            <section class="panel-card">
                <div class="panel-header">
                    <div>
                        <h2>Lista de produtos</h2>
                        <p>Pesquise pelo nome ou código e acompanhe o nível de cada material.</p>
                    </div>
                    <span class="codigo-produto">Total: <%= produtos.length %></span>
                </div>

                <form action="/produtos" method="GET" class="filtros-produtos">
                    <div class="campo-busca">
                        <label for="busca">Pesquisar por nome ou código</label>
                        <input
                            type="text"
                            id="busca"
                            name="busca"
                            placeholder="Ex.: Parafuso ou MAT001"
                            value="<%= busca || '' %>"
                        >
                    </div>

                    <label class="filtro-estoque" for="estoqueBaixo">
                        <input
                            type="checkbox"
                            id="estoqueBaixo"
                            name="estoqueBaixo"
                            value="sim"
                            <%= estoqueBaixo === 'sim' ? 'checked' : '' %>
                        >
                        Mostrar somente produtos com estoque baixo
                    </label>

                    <div class="acoes-filtros">
                        <button type="submit">Buscar / Filtrar</button>
                        <a href="/produtos" class="botao-secundario">Limpar filtros</a>
                    </div>
                </form>

                <% if (produtos.length === 0) { %>
                    <div class="estado-vazio">
                        <h3>Nenhum produto encontrado</h3>
                        <p>Tente alterar os filtros ou cadastre um novo produto.</p>
                    </div>
                <% } else { %>

                    <div class="table-wrapper">
                        <table class="dashboard-table">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Nome</th>
                                    <th>Estoque atual</th>
                                    <th>Estoque mínimo</th>
                                    <th>Estoque máximo</th>
                                    <% if (permissoes.cadastrarProdutos) { %><th>Ações</th><% } %>
                                </tr>
                            </thead>

                            <tbody>
                                <% produtos.forEach(produto => {
                                    const baixo = produto.quantidade <= produto.estoque_minimo;
                                    const referencia = Math.max(produto.estoque_maximo || 0, produto.quantidade, 1);
                                    const nivel = Math.min(100, Math.round((produto.quantidade / referencia) * 100));
                                %>
                                    <tr>
                                        <td>
                                            <span class="codigo-chip">MAT<%= String(produto.id).padStart(3, '0') %></span>
                                        </td>

                                        <td><strong><%= produto.nome %></strong></td>

                                        <td>
                                            <div class="nivel-estoque">
                                                <div class="nivel-estoque-topo">
                                                    <strong><%= produto.quantidade %></strong>
                                                    <% if (baixo) { %>
                                                        <span class="status-badge status-warning">Estoque baixo</span>
                                                    <% } %>
                                                </div>
                                                <span class="nivel-estoque-barra" aria-hidden="true">
                                                    <span class="<%= baixo ? 'nivel-baixo' : '' %>" style="width: <%= nivel %>%"></span>
                                                </span>
                                            </div>
                                        </td>

                                        <td><%= produto.estoque_minimo %></td>
                                        <td><%= produto.estoque_maximo %></td>

                                        <% if (permissoes.cadastrarProdutos) { %>
                                        <td>
                                            <div class="acoes-tabela">
                                                <a
                                                    href="/produtos/<%= produto.id %>/editar"
                                                    class="botao-acao"
                                                >
                                                    ✎ Editar
                                                </a>

                                                <form
                                                    action="/produtos/<%= produto.id %>/excluir"
                                                    method="POST"
                                                    class="form-excluir"
                                                >
                                                    <input
                                                        type="hidden"
                                                        name="_csrf"
                                                        value="<%= csrfToken %>"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="botao-excluir"
                                                        onclick="return confirm('Tem certeza que deseja excluir este produto?')"
                                                    >
                                                        🗑 Excluir
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                        <% } %>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                <% } %>
            </section>

            <footer class="dashboard-footer">
                Sistema de Controle de Estoque · MVP
            </footer>

        </main>
    </div>

    <script src="/script.js"></script>

    <script>
        const mensagemProdutos = document.getElementById('mensagemProdutos');

        if (mensagemProdutos) {
            setTimeout(() => {
                mensagemProdutos.style.transition = 'opacity 0.5s';
                mensagemProdutos.style.opacity = '0';

                setTimeout(() => mensagemProdutos.remove(), 500);
            }, 3000);
        }
    </script>
</body>
</html>
